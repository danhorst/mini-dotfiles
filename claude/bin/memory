#!/usr/bin/env bash
set -euo pipefail

# Claude Code adapter for the shared memory engine (agents/bin/memory). Resolves
# this harness's seed corpus and per-project live-copy location, then delegates.
# Invoked bare (claude/bin on PATH) from the SessionStart hook, the pre-commit,
# and /wrap-it-up.

CLAUDE_ROOT="$(dirname "$(readlink "$HOME/.claude/commands")")"
AGENTS_ROOT="$CLAUDE_ROOT/../agents"

export MEMORY_SEEDS_DIR="$AGENTS_ROOT/memory"
export MEMORY_LIVE_DIR="$HOME/.claude/projects/${PWD//\//-}/memory"

exec "$AGENTS_ROOT/bin/memory" "$@"
